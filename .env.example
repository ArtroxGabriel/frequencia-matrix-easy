# Public HTTPS domain where the widget will be served (used by Caddy).
DOMAIN=frequencia.exemplo.ufc.br

# Matrix homeserver and bot credentials.
MATRIX_HOMESERVER_URL=https://matrix.dc.ufc.br
MATRIX_USER_ID=@frequencia-bot:matrix.dc.ufc.br
MATRIX_ACCESS_TOKEN=syt_replace_with_real_token

# Comma-separated homeservers allowed to invite the bot (leave empty to allow any).
MATRIX_AUTOJOIN_SERVERS=matrix.dc.ufc.br

# Duration of a mobile PIN session (Go duration format).
PIN_SESSION_TTL=24h
